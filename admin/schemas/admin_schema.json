{
  "version": "content_creator_admin_schema_v2.0.0",
  "description": "Admin schema with 3 modules: user_profile (left), baseline (right adjustable), tuning (right override). Includes defaults, merge rules, and prompt templates.",
  "modules": {
    "user_profile": {
      "module_id": "user_profile",
      "title": "客户信息（左侧参考）",
      "type": "object",
      "required": ["platform", "content_count", "word_count_range"],
      "properties": {
        "platform": {
          "type": "string",
          "title": "平台",
          "enum": ["xiaohongshu", "moments", "weibo", "douyin_copy", "general"],
          "default": "xiaohongshu"
        },
        "content_count": {
          "type": "integer",
          "title": "内容数量",
          "minimum": 1,
          "maximum": 200,
          "default": 10
        },
        "word_count_range": {
          "type": "object",
          "title": "单条字数范围",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 50, "maximum": 2000, "default": 300 },
            "max": { "type": "integer", "minimum": 50, "maximum": 2000, "default": 500 }
          },
          "default": { "min": 300, "max": 500 }
        },
        "age_band": {
          "type": "string",
          "title": "客户年龄段",
          "enum": ["18-25", "26-30", "31-35", "36-40", "40+"],
          "default": "26-30"
        },
        "education": {
          "type": "string",
          "title": "受教育程度",
          "enum": ["high_school", "college", "bachelor", "master", "phd"],
          "default": "bachelor"
        },
        "account_age": {
          "type": "string",
          "title": "账号运营时长",
          "enum": ["<1m", "1m", "3m", "6m", "12m", "24m+"],
          "default": "3m"
        },
        "creator_positioning": {
          "type": "string",
          "title": "个人定位（一句话）",
          "maxLength": 60,
          "default": ""
        },
        "keywords": {
          "type": "array",
          "title": "关键词（可多个）",
          "items": { "type": "string", "maxLength": 20 },
          "maxItems": 30,
          "default": []
        },
        "target_audience": {
          "type": "object",
          "title": "面向受众",
          "properties": {
            "gender": { "type": "string", "enum": ["all", "female", "male"], "default": "all" },
            "age_band": { "type": "string", "enum": ["18-25", "20-30", "25-35", "30-40", "40+"], "default": "20-30" },
            "interest": { "type": "string", "title": "兴趣/领域", "maxLength": 40, "default": "" }
          },
          "default": { "gender": "all", "age_band": "20-30", "interest": "" }
        },
        "tone_notes": {
          "type": "string",
          "title": "客户补充要求（自由文本）",
          "maxLength": 800,
          "default": ""
        },
        "future_monetization": {
          "type": "object",
          "title": "未来变现方向（可选）",
          "properties": {
            "might_sell_products": { "type": "boolean", "default": false },
            "product_types": {
              "type": "array",
              "items": { "type": "string", "maxLength": 20 },
              "default": []
            },
            "current_stage": {
              "type": "string",
              "enum": ["no_monetization", "account_warming", "soft_hint_only", "lightly_promote", "active_sales"],
              "default": "account_warming"
            }
          },
          "default": {
            "might_sell_products": false,
            "product_types": [],
            "current_stage": "account_warming"
          }
        }
      }
    },

    "baseline": {
      "module_id": "baseline",
      "title": "Baseline（右侧可调）",
      "type": "object",
      "required": [
        "de_ai_strength",
        "incompleteness",
        "anti_structure",
        "language",
        "perspective",
        "batch_rules",
        "output_packaging",
        "ending_discussion"
      ],
      "properties": {
        "de_ai_strength": {
          "type": "string",
          "title": "去AI强度",
          "enum": ["low", "medium", "high", "extreme"],
          "default": "high"
        },

        "incompleteness": {
          "type": "object",
          "title": "不完整原则",
          "required": ["level", "must_hit_at_least_one"],
          "properties": {
            "level": { "type": "integer", "title": "不完整程度(0-100)", "minimum": 0, "maximum": 100, "default": 70 },
            "must_hit_at_least_one": {
              "type": "array",
              "title": "每条至少命中1项",
              "items": { "type": "string", "enum": ["topic_not_closed", "emotion_not_named", "logic_not_closed", "stop_midway", "thought_interrupted", "ending_left_blank"] },
              "minItems": 1,
              "default": ["logic_not_closed"]
            },
            "forbidden_behaviors": {
              "type": "array",
              "title": "禁止行为（出现即判失败）",
              "items": { "type": "string", "enum": ["wrap_up_summary", "moralize_to_reader", "uplift_to_conclusion", "explain_everything", "close_the_loop"] },
              "default": ["wrap_up_summary", "uplift_to_conclusion", "close_the_loop"]
            }
          },
          "default": {
            "level": 70,
            "must_hit_at_least_one": ["logic_not_closed"],
            "forbidden_behaviors": ["wrap_up_summary", "uplift_to_conclusion", "close_the_loop"]
          }
        },

        "anti_structure": {
          "type": "object",
          "title": "反结构控制",
          "required": ["level", "forbidden_structures", "allowed_intentions"],
          "properties": {
            "level": { "type": "string", "enum": ["off", "light", "strong", "extreme"], "default": "strong" },
            "forbidden_structures": {
              "type": "array",
              "title": "禁止稳定结构",
              "items": { "type": "string", "enum": ["qi_cheng_zhuan_he", "problem_analysis_conclusion", "phenomenon_analysis_conclusion", "empathy_comfort_uplift", "question_answer_wrap", "story_reflection_moral"] },
              "default": ["qi_cheng_zhuan_he", "problem_analysis_conclusion", "empathy_comfort_uplift"]
            },
            "allowed_intentions": {
              "type": "array",
              "title": "允许结构意图（不是模板）",
              "items": { "type": "string", "enum": ["start_from_action_and_break", "self_correction_midway", "sudden_realization_no_explain", "stop_halfway", "throw_idea_no_expand", "drop_into_middle"] },
              "default": ["start_from_action_and_break", "stop_halfway", "drop_into_middle"]
            }
          },
          "default": {
            "level": "strong",
            "forbidden_structures": ["qi_cheng_zhuan_he", "problem_analysis_conclusion", "empathy_comfort_uplift"],
            "allowed_intentions": ["start_from_action_and_break", "stop_halfway", "drop_into_middle"]
          }
        },

        "language": {
          "type": "object",
          "title": "语言层控制",
          "required": ["line_break", "density", "banlist", "life_words_first"],
          "properties": {
            "line_break": {
              "type": "object",
              "title": "断句规则",
              "required": ["style"],
              "properties": {
                "style": { "type": "string", "enum": ["breath_only", "emotion_only", "mixed", "minimal_breaks", "random_like_human"], "default": "mixed" },
                "forbid_pretty_formatting": { "type": "boolean", "default": true }
              },
              "default": { "style": "mixed", "forbid_pretty_formatting": true }
            },
            "density": {
              "type": "object",
              "title": "语言密度",
              "required": ["level"],
              "properties": {
                "level": { "type": "string", "enum": ["tight", "balanced", "loose", "sparse"], "default": "balanced" },
                "allow_repetition": { "type": "boolean", "default": true },
                "allow_asymmetry_sentence_length": { "type": "boolean", "default": true },
                "allow_nonessential_details": { "type": "boolean", "default": true }
              },
              "default": {
                "level": "balanced",
                "allow_repetition": true,
                "allow_asymmetry_sentence_length": true,
                "allow_nonessential_details": true
              }
            },
            "life_words_first": {
              "type": "object",
              "title": "生活词优先",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "life_detail_density": { "type": "string", "enum": ["low", "medium", "high"], "default": "medium" },
                "preferred_detail_types": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["weather", "body_sensation", "space", "time_fragments", "objects", "sounds_light", "small_actions", "commute", "desk_work"] },
                  "default": ["time_fragments", "objects", "small_actions", "space"]
                }
              },
              "default": {
                "enabled": true,
                "life_detail_density": "medium",
                "preferred_detail_types": ["time_fragments", "objects", "small_actions", "space"]
              }
            },
            "banlist": {
              "type": "object",
              "title": "封禁词与行为（出现即重写）",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "banned_words": {
                  "type": "array",
                  "items": { "type": "string" },
                  "default": ["本质是", "其实", "归根结底", "说到底", "边界", "梳理", "缓冲", "接住", "明确", "刻意"]
                },
                "banned_behaviors": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["preach", "judge_reader", "give_should", "give_solution", "final_conclusion"] },
                  "default": ["preach", "give_solution", "final_conclusion"]
                }
              },
              "default": {
                "enabled": true,
                "banned_words": ["本质是", "其实", "归根结底", "说到底", "边界", "梳理", "缓冲", "接住", "明确", "刻意"],
                "banned_behaviors": ["preach", "give_solution", "final_conclusion"]
              }
            }
          },
          "default": {
            "line_break": { "style": "mixed", "forbid_pretty_formatting": true },
            "density": { "level": "balanced", "allow_repetition": true, "allow_asymmetry_sentence_length": true, "allow_nonessential_details": true },
            "life_words_first": { "enabled": true, "life_detail_density": "medium", "preferred_detail_types": ["time_fragments", "objects", "small_actions", "space"] },
            "banlist": { "enabled": true, "banned_words": ["本质是", "其实", "归根结底", "说到底", "边界", "梳理", "缓冲", "接住", "明确", "刻意"], "banned_behaviors": ["preach", "give_solution", "final_conclusion"] }
          }
        },

        "perspective": {
          "type": "object",
          "title": "视角与站位",
          "required": ["person", "timeframe", "forbidden_roles"],
          "properties": {
            "person": { "type": "string", "enum": ["first_person"], "default": "first_person" },
            "timeframe": { "type": "string", "enum": ["present_only"], "default": "present_only" },
            "forbidden_roles": { "type": "array", "items": { "type": "string", "enum": ["correctness_seat", "explainer_seat", "persuader_seat", "coach_seat", "judge_seat"] }, "default": ["explainer_seat", "coach_seat", "judge_seat"] },
            "forbidden_questions": { "type": "array", "items": { "type": "string", "enum": ["should_or_not", "worth_or_not", "right_or_wrong"] }, "default": ["should_or_not", "worth_or_not", "right_or_wrong"] }
          },
          "default": {
            "person": "first_person",
            "timeframe": "present_only",
            "forbidden_roles": ["explainer_seat", "coach_seat", "judge_seat"],
            "forbidden_questions": ["should_or_not", "worth_or_not", "right_or_wrong"]
          }
        },

        "commercial_shadow": {
          "type": "object",
          "title": "商业/带货/接单暗线（可选）",
          "properties": {
            "presence_level": { "type": "integer", "minimum": 0, "maximum": 100, "default": 10 },
            "allowed_modes": { "type": "array", "items": { "type": "string", "enum": ["only_everyday_objects", "mention_books_tools", "soft_private_chat_hint", "soft_collab_hint", "no_commercial"] }, "default": ["only_everyday_objects", "mention_books_tools"] },
            "forbidden_modes": { "type": "array", "items": { "type": "string", "enum": ["direct_sell", "call_to_action_follow", "call_to_action_comment", "explicit_ad_copy"] }, "default": ["direct_sell", "explicit_ad_copy"] }
          },
          "default": {
            "presence_level": 10,
            "allowed_modes": ["only_everyday_objects", "mention_books_tools"],
            "forbidden_modes": ["direct_sell", "explicit_ad_copy"]
          }
        },

        "batch_rules": {
          "type": "object",
          "title": "批量生成规则（10条/批）",
          "required": ["quality_variance", "unfinished_ratio", "awkward_count", "start_diversity"],
          "properties": {
            "quality_variance": { "type": "string", "enum": ["uniform", "small_variance", "forced_variance"], "default": "forced_variance" },
            "unfinished_ratio": { "type": "integer", "minimum": 0, "maximum": 100, "default": 60 },
            "awkward_count": { "type": "integer", "minimum": 0, "maximum": 10, "default": 1 },
            "start_diversity": {
              "type": "object",
              "title": "开头反重复",
              "required": ["level", "max_time_openers", "min_start_types", "start_types", "start_type_distribution"],
              "properties": {
                "level": { "type": "string", "enum": ["off", "avoid_repeat", "strong", "extreme"], "default": "strong" },
                "max_time_openers": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 },
                "min_start_types": { "type": "integer", "minimum": 1, "maximum": 8, "default": 5 },
                "start_types": { "type": "array", "items": { "type": "string", "enum": ["time", "action", "scene", "object", "dialogue_fragment", "thought_interrupt", "body_sensation", "drop_into_middle"] }, "default": ["action", "scene", "object", "dialogue_fragment", "thought_interrupt"] },
                "start_type_distribution": {
                  "type": "object",
                  "properties": {
                    "time": { "type": "integer", "minimum": 0, "maximum": 100, "default": 10 },
                    "action": { "type": "integer", "minimum": 0, "maximum": 100, "default": 20 },
                    "scene": { "type": "integer", "minimum": 0, "maximum": 100, "default": 20 },
                    "object": { "type": "integer", "minimum": 0, "maximum": 100, "default": 15 },
                    "dialogue_fragment": { "type": "integer", "minimum": 0, "maximum": 100, "default": 10 },
                    "thought_interrupt": { "type": "integer", "minimum": 0, "maximum": 100, "default": 15 },
                    "body_sensation": { "type": "integer", "minimum": 0, "maximum": 100, "default": 5 },
                    "drop_into_middle": { "type": "integer", "minimum": 0, "maximum": 100, "default": 5 }
                  },
                  "default": { "time": 10, "action": 20, "scene": 20, "object": 15, "dialogue_fragment": 10, "thought_interrupt": 15, "body_sensation": 5, "drop_into_middle": 5 }
                }
              },
              "default": {
                "level": "strong",
                "max_time_openers": 2,
                "min_start_types": 5,
                "start_types": ["action", "scene", "object", "dialogue_fragment", "thought_interrupt"],
                "start_type_distribution": { "time": 10, "action": 20, "scene": 20, "object": 15, "dialogue_fragment": 10, "thought_interrupt": 15, "body_sensation": 5, "drop_into_middle": 5 }
              }
            }
          },
          "default": {
            "quality_variance": "forced_variance",
            "unfinished_ratio": 60,
            "awkward_count": 1,
            "start_diversity": {
              "level": "strong",
              "max_time_openers": 2,
              "min_start_types": 5,
              "start_types": ["action", "scene", "object", "dialogue_fragment", "thought_interrupt"],
              "start_type_distribution": { "time": 10, "action": 20, "scene": 20, "object": 15, "dialogue_fragment": 10, "thought_interrupt": 15, "body_sensation": 5, "drop_into_middle": 5 }
            }
          }
        },

        "output_packaging": {
          "type": "object",
          "title": "输出结构与平台适配",
          "required": ["platform_type", "structure_preset", "blocks", "title_rules", "hashtag_rules", "formatting"],
          "properties": {
            "platform_type": { "type": "string", "enum": ["xiaohongshu", "moments", "weibo", "douyin_copy", "general"], "default": "xiaohongshu" },
            "structure_preset": { "type": "string", "enum": ["pure_body", "title_body", "title_subtitle_body", "body_hashtags", "title_body_hashtags", "full", "experimental_min", "platform_auto"], "default": "platform_auto" },
            "blocks": { "type": "array", "items": { "type": "string", "enum": ["main_title", "sub_title", "body_content", "hashtags", "soft_footer", "none"] }, "default": ["main_title", "body_content", "hashtags"] },
            "title_rules": {
              "type": "object",
              "properties": {
                "main_title_style": { "type": "string", "enum": ["no_title", "life_like", "observation", "question", "interrupted", "experimental"], "default": "life_like" },
                "sub_title_behavior": { "type": "string", "enum": ["off", "context_hint", "weak_explain", "contrast", "experimental"], "default": "off" },
                "title_length": { "type": "string", "enum": ["short", "medium", "long"], "default": "short" },
                "forbid_template_titles": { "type": "boolean", "default": true }
              },
              "default": { "main_title_style": "life_like", "sub_title_behavior": "off", "title_length": "short", "forbid_template_titles": true }
            },
            "hashtag_rules": {
              "type": "object",
              "properties": {
                "enable_hashtags": { "type": "boolean", "default": true },
                "density": { "type": "string", "enum": ["very_low", "low", "medium", "high", "very_high"], "default": "low" },
                "count_range": {
                  "type": "object",
                  "required": ["min", "max"],
                  "properties": {
                    "min": { "type": "integer", "minimum": 0, "maximum": 30, "default": 1 },
                    "max": { "type": "integer", "minimum": 0, "maximum": 30, "default": 3 }
                  },
                  "default": { "min": 1, "max": 3 }
                },
                "types": { "type": "array", "items": { "type": "string", "enum": ["platform_generic", "vertical_interest", "emotion", "search_friendly", "event_time"] }, "default": ["platform_generic", "vertical_interest"] },
                "visibility": { "type": "string", "enum": ["invisible", "light", "medium", "strong"], "default": "light" }
              },
              "default": { "enable_hashtags": true, "density": "low", "count_range": { "min": 1, "max": 3 }, "types": ["platform_generic", "vertical_interest"], "visibility": "light" }
            },
            "formatting": {
              "type": "object",
              "properties": {
                "paragraph_density": { "type": "string", "enum": ["compact", "balanced", "loose", "random"], "default": "balanced" },
                "line_break_style": { "type": "string", "enum": ["natural", "emotion_driven", "random", "minimal"], "default": "natural" }
              },
              "default": { "paragraph_density": "balanced", "line_break_style": "natural" }
            }
          },
          "default": {
            "platform_type": "xiaohongshu",
            "structure_preset": "platform_auto",
            "blocks": ["main_title", "body_content", "hashtags"],
            "title_rules": { "main_title_style": "life_like", "sub_title_behavior": "off", "title_length": "short", "forbid_template_titles": true },
            "hashtag_rules": { "enable_hashtags": true, "density": "low", "count_range": { "min": 1, "max": 3 }, "types": ["platform_generic", "vertical_interest"], "visibility": "light" },
            "formatting": { "paragraph_density": "balanced", "line_break_style": "natural" }
          }
        },

        "ending_discussion": {
          "type": "object",
          "title": "结尾是否留下讨论口子",
          "required": ["level", "styles", "allow_soft_comment_hook", "openness_level", "allow_series_hook", "ending_style"],
          "properties": {
            "level": { "type": "string", "enum": ["off", "very_weak", "weak", "medium", "strong", "experimental"], "default": "weak" },
            "styles": { "type": "array", "items": { "type": "string", "enum": ["unfinished_thought", "stop_half_sentence", "soft_question_no_reader_callout", "dialogue_fragment", "life_continues", "no_discussion"] }, "default": ["unfinished_thought", "life_continues"] },
            "allow_soft_comment_hook": { "type": "boolean", "default": false },
            "openness_level": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
            "allow_series_hook": { "type": "boolean", "default": false },
            "ending_style": { "type": "string", "enum": ["fade_out", "stop_midway", "hang_thought", "life_continues", "experimental_break"], "default": "hang_thought" }
          },
          "default": {
            "level": "weak",
            "styles": ["unfinished_thought", "life_continues"],
            "allow_soft_comment_hook": false,
            "openness_level": 50,
            "allow_series_hook": false,
            "ending_style": "hang_thought"
          }
        },

        "self_check": {
          "type": "object",
          "title": "系统自检",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "checks": {
              "type": "array",
              "items": { "type": "string", "enum": ["must_not_require_completion", "must_not_trigger_summary_expectation", "must_not_be_generic_replaceable_i", "banlist_detection", "template_rhythm_detection", "start_repeat_detection"] },
              "default": ["must_not_require_completion", "must_not_trigger_summary_expectation", "banlist_detection", "start_repeat_detection"]
            },
            "failure_policy": {
              "type": "string",
              "enum": ["rewrite_until_pass", "mark_failed_keep", "manual_review"],
              "default": "rewrite_until_pass"
            }
          },
          "default": {
            "enabled": true,
            "checks": ["must_not_require_completion", "must_not_trigger_summary_expectation", "banlist_detection", "start_repeat_detection"],
            "failure_policy": "rewrite_until_pass"
          }
        }
      }
    },

    "tuning": {
      "module_id": "tuning",
      "title": "内容调节（最高标准，可覆盖）",
      "type": "object",
      "properties": {
        "override_text": {
          "type": "string",
          "title": "内容调节（默认留空）",
          "description": "最高优先级：用于覆盖客户信息与baseline。常规不填，只在需要强行改风格/禁区/口吻时填。",
          "maxLength": 4000,
          "default": ""
        }
      },
      "default": {
        "override_text": ""
      }
    }
  },

  "merge_rules": {
    "order": ["baseline", "user_profile", "tuning"],
    "strategy": "deep_merge",
    "tuning_override_policy": "text_overrides_all",
    "notes": "tuning.override_text 有内容时：以它为最高标准（不改 baseline 数据，只改 prompt 解释）。"
  },

  "prompt_templates": {
    "system": "你是一个中文社交平台内容生成器。目标：输出“像真人写的碎片”，而不是文章。禁止：总结收口、说教、给方案、给读者下指令。必须：自然断句、局部重复、信息不完整、留下未完。",
